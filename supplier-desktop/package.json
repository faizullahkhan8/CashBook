{
  "name": "zada-pharmacy-spms",
  "productName": "Zada Pharmacy SPMS",
  "version": "1.0.0",
  "description": "Zada Pharmacy Supplier & Payment Management System",
  "author": "Zada Pharmacy IT Team",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "app": "vite build && electron .",
    "dist:installer": "vite build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.zadapharmacy.spms",
    "productName": "Zada Pharmacy SPMS",
    "copyright": "Copyright © 2026 Zada Pharmacy",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zada Pharmacy SPMS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "vite": "^6.1.1"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true
  }
}

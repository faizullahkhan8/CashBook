# ========================================================
# ZADA PHARMACY SPMS - HOSTINGER VPS CONFIGURATION (.env)
# ========================================================

# Application Port
PORT=5000

# MySQL / MariaDB Database Connection (on Hostinger VPS or phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=zada_supplier_db

# Security & Authentication (Change this to a strong random secret)
JWT_SECRET=zada_spms_super_secret_jwt_key_2026_hostinger

# Initial Default Administrator (Created automatically on first start)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

{
  "name": "zada-pharmacy-cashbook",
  "version": "1.0.0",
  "description": "Pharmacy POS Cash Counter & Shift Closings Console",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "vite build && electron-packager . \"ZadaPharmacyPOS\" --platform=win32 --arch=x64 --out=release-builds --overwrite --prune=true --ignore=\"^/(release-builds|installers|src|\\.git)\"",
    "dist:installer": "vite build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.zadapharmacy.poscashbook",
    "productName": "Zada Pharmacy POS",
    "copyright": "Copyright © 2026 Zada Pharmacy. Developed by Zada IT Team (Humayun Khan & Faizullah)",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "legalTrademarks": "Zada Pharmacy",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zada Pharmacy POS",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/installerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/installerIcon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  },
  "keywords": [
    "pharmacy",
    "pos",
    "cash-counter",
    "shift-closing",
    "electron",
    "react",
    "sqlite"
  ],
  "author": "Zada IT Team (Humayun Khan & Faizullah)",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.1",
    "wait-on": "^8.0.2"
  }
}
